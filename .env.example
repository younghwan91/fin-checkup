# DART Open API 인증키 — https://opendart.fss.or.kr 에서 발급 (이메일만, 즉시)
# ⚠️ DART 이용약관 제19조: 인증키를 제3자에게 이용하게 해서는 안 됨. 이 파일은 커밋 금지.
DART_API_KEY=

# 캐시 DB 경로 (기본값: data/fin_checkup.duckdb)
# FIN_CHECKUP_DB_PATH=data/fin_checkup.duckdb

# DART 호출 간 최소 대기(초). 일별 호출 허용량 제한 대응 (약관 제10조)
# DART_MIN_DELAY=0.3

# 위험 공시 알림 (Phase 1.5) — @BotFather에서 발급, 무료
TELEGRAM_BOT_TOKEN=

# 미장 확장 (Phase 2) — SEC는 인증키 대신 연락처가 담긴 User-Agent를 요구한다.
# 없으면 403으로 막힌다.
SEC_USER_AGENT=fin-checkup your@email.com
